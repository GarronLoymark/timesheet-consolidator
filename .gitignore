# Datos reales (privacidad): nunca publicar timesheets con nombres reales.
# Los fixtures *.anon.xlsx sí se versionan (anonimizados con app/tools/anonymize.py).
/*.xlsx
app/test/fixtures/*.xlsx
!app/test/fixtures/*.anon.xlsx
app/test/_out.xlsx

# Archivos del sistema
.DS_Store
**/.DS_Store

# Editor / temporales
*.log
.vscode/

# Artefactos de CI / Node (solo herramientas, no runtime de la app)
node_modules/
package.json
package-lock.json
out.xlsx
recalc/
